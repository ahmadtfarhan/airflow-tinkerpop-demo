# Copy to .env and fill in.  `.env` is gitignored -- never commit it.

# Host UID so container-written files (logs/, data/) are owned by you, not root.
#   echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000

# Airflow metadata encryption key.  Generate your OWN -- do not reuse any key
# that has ever been committed to a public repo.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Shared secret components use to authenticate to the execution API
# (required from Airflow 3.2 on). Any stable random string works locally.
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret

# Google AI Studio key (https://aistudio.google.com/apikey).
# Used in Generative Language API mode = the free tier.
GEMINI_API_KEY=

# Optional second key on a different Google Cloud project, so a mid-demo
# quota exhaustion is a one-line connection swap rather than a dead demo.
GEMINI_API_KEY_BACKUP=
